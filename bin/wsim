#!/usr/bin/env -S uv run --script
#
# wsim
# David_Harris@hmc.edu 5 April 2024
# Invoke a Wally simulation for a desired configuration and set of ELF files on the specified simulator
# usage: wsim CONFIG [ELF|DIRECTORY]... [-s/--sim SIMULATOR] [-g/--gui]
# Every ELF named, and every *.elf found under every directory named, runs back-to-back in a single
# simulation session.  Tests check themselves, so the simulation reports a single pass/fail summary.
# example: wsim rv64gc test.elf
# example: wsim rv64gc addins/riscv-arch-test/work/cvw-rv64gc/elfs/rv64i/I
# example: wsim rv32gc a.elf b.elf c.elf -s verilator
# example: wsim rv64gc buildroot
# example: wsim fdqh_ieee_rv64gc add -t testbench_fp        # run TestFloat
#
# SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1

import argparse
import fcntl
import hashlib
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

# Global variables
WALLY = Path(os.environ.get("WALLY", Path(__file__).resolve().parent.parent))

# Tests that load their own memory image rather than a list of ELF files
SPECIAL_TESTS = ("buildroot", "fpga")

# Tests that run from ELF files but need special handling in the testbench (--test MODE)
SPECIAL_MODES = SPECIAL_TESTS + ("coremark", "embench")

# Directories holding design and testbench sources; used to decide whether to recompile
DESIGN_DIRS = ("src", "testbench", "config", "addins/verilog-ethernet")
# The riscv-arch-test covergroups are compiled into the design only with --fcov
FCOV_DIRS = ("addins/riscv-arch-test/coverpoints", "addins/riscv-arch-test/framework/src/act/fcov")

# Symbols the testbench needs from each ELF: where the test reports its result, and (embench) its signature
ELF_SYMBOLS = ("tohost", "begin_signature")


def parseArgs():
    parser = argparse.ArgumentParser()
    parser.add_argument("config", help="Configuration file")
    parser.add_argument("tests", nargs="*", default=[],
                        help="ELF files and/or directories of ELF files to run back-to-back in one simulation "
                             f"(directories are searched recursively for *.elf), or one of {', '.join(SPECIAL_TESTS)}. "
                             "With --tb testbench_fp, the name of the TestFloat test instead.")
    parser.add_argument("--elf", "-e", help="ELF File name; use if name does not end in .elf", default="")
    parser.add_argument("--test", "-T", help="Special test mode", choices=SPECIAL_MODES, default="")
    parser.add_argument("--name", "-n", help="Name used for log and coverage database files", default="")
    parser.add_argument("--sim", "-s", help="Simulator", choices=["questa", "verilator", "vcs"], default="questa")
    parser.add_argument("--tb", "-t", help="Testbench", choices=["testbench", "testbench_fp"], default="testbench")
    parser.add_argument("--gui", "-g", help="Simulate with GUI", action="store_true")
    parser.add_argument("--ccov", "-c", help="Code Coverage", action="store_true")
    parser.add_argument("--fcov", "-f", help="Functional Coverage; Currently does nothing", action="store_true")
    parser.add_argument("--args", "-a", help="Optional arguments passed to simulator via $value$plusargs", default="")
    parser.add_argument("--params", "-p", help="Optional top-level parameter overrides of the form param=value", default="")
    parser.add_argument("--define", "-d", help="Optional define macros passed to simulator", default="")
    parser.add_argument("--vcd", "-v", help="Generate testbench.vcd", action="store_true")
    parser.add_argument("--lockstep", "-l", help="Run ImperasDV lock, step, and compare.", action="store_true")
    parser.add_argument("--lockstepverbose", "-lv", help="Run ImperasDV lock, step, and compare with tracing enabled", action="store_true")
    parser.add_argument("--rvvi", "-r", help="Simulate rvvi hardware interface and ethernet.", action="store_true")
    return parser.parse_args()


def validateArgs(args):
    if not args.tests and not args.elf and not args.test:
        print("Error: Missing ELF file, directory of ELF files, or test name")
        sys.exit(1)
    if args.gui and args.sim != "questa":
        print("GUI only supported by Questa")
        sys.exit(1)
    elif (args.ccov or args.fcov) and args.sim != "questa":
        print("Coverage only supported by Questa")
        sys.exit(1)
    elif any([args.lockstep, args.lockstepverbose]) and args.sim not in ["questa", "vcs"]:
        print("Lockstep only supported by Questa and VCS")
        sys.exit(1)
    elif args.tb == "testbench_fp" and args.sim != "questa":
        print("Error: testbench_fp presently only supported by Questa, not VCS or Verilator, because of a touchy testbench")
        sys.exit(1)


def collectTests(args):
    """Expand the positional arguments and --elf into the list of ELF files to run.

    Each argument is an ELF file, a directory searched recursively for *.elf, or the name of a
    special test (buildroot, fpga) that loads its own memory image.  Returns the ELF list and a
    short name for each argument, used to name log and coverage files."""
    elfs = []
    names = []
    for item in list(args.tests) + ([args.elf] if args.elf else []):
        path = Path(item)
        if path.is_dir():
            found = sorted(path.resolve().rglob("*.elf"))
            if not found:
                print(f"Error: No .elf files found in {item}")
                sys.exit(1)
            elfs += [str(f) for f in found]
            names.append(f"{path.resolve().parent.name}_{path.resolve().name}")
        elif path.is_file():
            elfs.append(str(path.resolve()))
            names.append(f"{path.resolve().parent.name}_{path.stem}")
        elif item in SPECIAL_TESTS:
            args.test = item
        else:
            print(f"Test not found: {item}")
            sys.exit(1)
    if (args.lockstep or args.lockstepverbose) and len(elfs) != 1 and args.test != "buildroot":
        print(f"Invalid Options. Lockstep runs one ELF at a time, but {len(elfs)} were given.")
        sys.exit(1)
    return elfs, names


def runName(args, elfs, names):
    """Pick the name used for log files and coverage databases."""
    if args.name:
        return args.name
    if args.test and not names:
        return args.test
    if len(names) == 1:
        return names[0]
    return f"{names[0]}_plus{len(elfs) - 1}"


def elfSymbols(elfs):
    """Look up the address of each ELF_SYMBOLS entry in every ELF with nm (0 if absent).
    One nm call covers all the ELFs; with several files nm prefixes each file's symbols with a "<path>:" line."""
    symbols = {elf: dict.fromkeys(ELF_SYMBOLS, 0) for elf in elfs}
    nm = shutil.which("riscv64-unknown-elf-nm")
    if nm is None:
        print("Warning: riscv64-unknown-elf-nm not found; tests cannot report results through tohost")
        return symbols
    current = elfs[0]
    for line in subprocess.run([nm, *elfs], capture_output=True, text=True).stdout.splitlines():
        if line.endswith(":") and line[:-1] in symbols:
            current = line[:-1]
            continue
        fields = line.split()
        if len(fields) == 3 and fields[2] in ELF_SYMBOLS:
            symbols[current][fields[2]] = int(fields[0], 16)
    return symbols


def prepareElfs(args, elfs):
    """Generate the .memfile for every ELF (in parallel, only if out of date) and write the ELF list.
    Each line of the list holds the ELF path followed by the hex addresses of ELF_SYMBOLS."""
    memfiles = " ".join(f"{elf}.memfile" for elf in elfs)
    if subprocess.run(f"make -s -j -f {WALLY}/testbench/Makefile WALLY={WALLY} {memfiles}", shell=True).returncode:
        print("Error: could not generate memfiles")
        sys.exit(1)
    symbols = elfSymbols(elfs)
    listdir = WALLY / "sim" / args.sim / "testlists"
    listdir.mkdir(parents=True, exist_ok=True)
    listfile = listdir / f"{args.config}_{args.tb}_{args.testsuite}.txt"
    listfile.write_text("".join(f"{elf} " + " ".join(f"{symbols[elf][name]:x}" for name in ELF_SYMBOLS) + "\n" for elf in elfs))
    return listfile


def prepSim(args, elfs):
    prefix = ""
    paramsList = []
    argsList = []
    flagsList = []
    defineList = []
    if args.vcd:
        paramsList.append("MAKE_VCD=1")
        if args.sim == "questa":
            flagsList.append("--vcd")
    if args.rvvi:
        paramsList.append("RVVI_SYNTH_SUPPORTED=1")
    if args.tb == "testbench_fp":
        paramsList.append(f'TEST="{args.testsuite}"')
    if elfs:
        argsList.append(f"+ElfList={prepareElfs(args, elfs)}")
    if args.gui and args.tb == "testbench":
        paramsList.append("DEBUG=1")
    if args.ccov:
        flagsList.append("--ccov")
    if args.fcov:
        flagsList.append("--fcov")
        defineList.append("+define+FCOV")
    if args.gui:
        flagsList.append("--gui")
    if args.lockstep or args.lockstepverbose:
        flagsList.append("--lockstep")
        prefix += lockstepSetup(args)
        defineList.append("+define+USE_IMPERAS_DV")
    if "breker" in args.config and args.sim != "verilator":  # Requires a license for the breker tool. See tests/breker/README.md for details
        ElfFileNoExtension = os.path.splitext(elfs[0])[0]
        flagsList.append("--breker")
        defineList.append("+define+USE_TREK_DV")
        argsList.append(f"+TREK_TBX_FILE={ElfFileNoExtension}.tbx")
        if "WALLY_UVM_PKG" not in os.environ:
            prefix += f"WALLY_UVM_PKG={WALLY}/testbench/trek_files/{'rv64' if args.config == 'rv64breker' else 'rv32'}/uvm_output/trek_uvm_pkg.sv"
    # Combine into a single string
    args.args += " " + " ".join(argsList)
    args.params += " " + " ".join(paramsList)
    args.define += " " + " ".join(defineList)
    flags = " ".join(flagsList)
    return flags, prefix


def lockstepSetup(args):
    imperasicSharedPath = WALLY / "config" / "shared" / "imperas-shared.ic"
    imperasicVerbosePath = WALLY / "sim" / "imperas-verbose.ic"
    imperasicPath = WALLY / "config" / str(args.config) / "imperas.ic"
    if not imperasicPath.is_file():  # If config is a derivative, look for imperas.ic in derivative configs
        imperasicPath = WALLY / "config" / "deriv" / str(args.config) / "imperas.ic"
        if not imperasicPath.is_file():
            print("Error: imperas.ic not found")
            sys.exit(1)
    prefix = f"IMPERAS_TOOLS={imperasicSharedPath}:{imperasicPath}{f':{imperasicVerbosePath}' if args.lockstepverbose else ''}"
    return prefix


def createDirs(sim: str):
    for d in ["logs", "wkdir", "cov", "ucdb", "fcov", "fcov_ucdb"]:
        (WALLY / "sim" / sim / d).mkdir(parents=True, exist_ok=True)


def buildHash(*components):
    """Compute an 8-char hash from compile-time parameters for the workdir suffix."""
    combined = " ".join(" ".join(str(c) for c in components).split())
    return hashlib.md5(combined.encode()).hexdigest()[:8] if combined else ""


def compileLock(sim_dir, lockname):
    """Context manager that acquires an exclusive flock for compilation serialization."""
    lockdir = WALLY / "sim" / sim_dir / "wkdir"
    lockdir.mkdir(parents=True, exist_ok=True)
    lockfile = lockdir / f".{lockname}.lock"

    class _Lock:
        def __enter__(self):
            self._f = open(lockfile, "w")
            fcntl.flock(self._f, fcntl.LOCK_EX)
            return self

        def __exit__(self, *exc):
            fcntl.flock(self._f, fcntl.LOCK_UN)
            self._f.close()

    return _Lock()


def isDesignUpToDate(target, extra_dirs=()):
    """Check if a compiled design target is newer than all source/config files.
    Returns True if the target exists and is newer than all dependencies."""
    if not target.exists():
        return False
    target_mtime = target.stat().st_mtime
    for d in DESIGN_DIRS + tuple(extra_dirs):
        for ext in ("*.sv", "*.v", "*.svh", "*.vh"):
            for dep in (WALLY / d).rglob(ext):
                if dep.stat().st_mtime > target_mtime:
                    return False
    return True


def targetMtime(target):
    return target.stat().st_mtime if target.exists() else None


def successPattern(args):
    """Regex for the summary line a passing run prints, or None if the run's output is not checked."""
    if args.gui:
        return None
    if args.tb == "testbench_fp":
        return r"All Tests completed with\s+0 errors"
    if not args.test:  # ELF runs; special modes such as buildroot have their own pass criteria
        return r"All tests ran without failures"
    return None


def shell(cmd, success=None):
    """Run a shell command and return its exit code.

    The simulators exit 0 even when tests fail, so when success is given the output is echoed and
    scanned, and a run that exits 0 without printing a matching line returns 1."""
    if success is None:
        return subprocess.run(cmd, shell=True).returncode
    proc = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    passed = False
    for line in proc.stdout:
        print(line, end="", flush=True)
        passed = passed or re.search(success, line) is not None
    code = proc.wait()
    return code if code else (0 if passed else 1)


def checkCompiled(target, sim):
    """Report an error if compilation did not leave a design behind."""
    if not target.exists():
        print(f"Error: {sim} compiled design not found: {target}", file=sys.stderr)
        return 1
    return 0


def runSim(args, flags, prefix):
    if args.sim == "questa":
        return runQuesta(args, flags, prefix)
    elif args.sim == "verilator":
        return runVerilator(args)
    elif args.sim == "vcs":
        return runVCS(args, flags, prefix)
    print(f"Error: unknown simulator {args.sim}", file=sys.stderr)
    return 1


def runQuesta(args, flags, prefix):
    # Force Questa to use 64-bit mode, sometimes it defaults to 32-bit even on 64-bit machines
    prefix = "MTI_VCO_MODE=64 " + prefix
    sim_dir = "$WALLY/sim/questa"

    # Compute build hash from all compile-time parameters (flags, params, defines)
    bhash = buildHash(flags, args.params, args.define)
    wkdir = f"wkdir/{args.config}_{args.tb}{'_' + bhash if bhash else ''}"

    # Build compile-time flag arguments
    compile_flags = flags
    if args.params.strip():
        compile_flags += rf" --params \"{args.params}\""
    if args.define.strip():
        compile_flags += rf" --define \"{args.define}\""

    # Phase 1: Compile (only once per config/flags/params/defines combo)
    print(f"Running Questa on {args.config} {args.testsuite}")
    wkdir_path = WALLY / "sim" / "questa" / wkdir
    target = wkdir_path / "testbenchopt"
    target_mtime = targetMtime(target)
    needs_compile = target_mtime is None or not isDesignUpToDate(target, FCOV_DIRS if args.fcov else ())
    with compileLock("questa", f"{args.config}_{args.tb}{'_' + bhash if bhash else ''}"):
        current_mtime = targetMtime(target)
        if needs_compile and current_mtime == target_mtime:
            compile_cmd = f'do wally-compile.do {args.config} {args.tb} {wkdir} {compile_flags}'
            compile_cmd = f'cd {sim_dir}; {prefix} vsim -c -do "{compile_cmd}"'
            rc = shell(compile_cmd)
            if rc:
                print(f"Error: Questa compilation failed for {args.config} {args.tb}", file=sys.stderr)
                return rc
    if checkCompiled(target, "Questa"):
        return 1

    # Phase 2: Run the simulation
    run_flags = flags
    if args.args.strip():
        run_flags += rf" --args \"{args.args}\""
    run_cmd = f'do wally-run.do {args.config} {args.testsuite} {args.tb} {wkdir} {run_flags}'
    run_cmd = f'cd {sim_dir}; {prefix} vsim {"-c" if not args.gui else ""} -do "{run_cmd}"'
    return shell(run_cmd, successPattern(args))


def runVerilator(args):
    print(f"Running Verilator on {args.config} {args.testsuite}")
    sim_dir = WALLY / "sim" / "verilator"
    bhash = buildHash(args.params, args.define)
    workdir = sim_dir / "wkdir" / f"{args.config}_{args.tb}{'_' + bhash if bhash else ''}"
    binary = workdir / f"V{args.tb}"

    # Phase 1: Compile (only once per config/params/defines combo)
    compile_cmd = (
        f'make -C {sim_dir}'
        f' WALLYCONF={args.config}'
        f' TESTBENCH={args.tb}'
        f' PARAM_ARGS="{args.params}"'
        f' DEFINE_ARGS="{args.define}"'
        f' BUILD_HASH="{bhash}"'
    )
    target_mtime = targetMtime(binary)
    needs_compile = target_mtime is None or not isDesignUpToDate(binary)
    with compileLock("verilator", f"{args.config}_{args.tb}{'_' + bhash if bhash else ''}"):
        current_mtime = targetMtime(binary)
        if needs_compile and current_mtime == target_mtime:
            rc = shell(compile_cmd)
            if rc:
                print(f"Error: Verilator compilation failed for {args.config} {args.tb}", file=sys.stderr)
                return rc
    if checkCompiled(binary, "Verilator"):
        return 1

    # Phase 2: Run the simulation (parallel safe)
    # Run from sim/verilator/ so relative paths (e.g. logs/buildroot_uart.out) resolve correctly
    (sim_dir / "logs").mkdir(parents=True, exist_ok=True)
    runtime_args = ""
    if args.tb == "testbench":
        runtime_args += f" +TEST={args.testsuite}"
    if args.args.strip():
        runtime_args += f" {args.args.strip()}"
    return shell(f"cd {sim_dir} && {binary}{runtime_args}", successPattern(args))


def runVCS(args, flags, prefix):
    print(f"Running VCS on {args.config} {args.testsuite}")
    sim_dir = "$WALLY/sim/vcs"
    bhash = buildHash(flags, args.params, args.define)
    wkdir = f"{WALLY}/sim/vcs/wkdir/{args.config}_{args.tb}{'_' + bhash if bhash else ''}"
    binary = Path(wkdir) / "sim_out"

    # Build compile-time flag arguments (flags already contains --lockstep, --breker, etc. from prepSim)
    compile_flags = f"--tb {args.tb} {flags}"
    if args.params.strip():
        compile_flags += f' --params "{args.params}"'
    if args.define.strip():
        compile_flags += f' --define "{args.define}"'

    # Phase 1: Compile (only once per config/flags/params/defines combo)
    target_mtime = targetMtime(binary)
    needs_compile = target_mtime is None or not isDesignUpToDate(binary)
    with compileLock("vcs", f"{args.config}_{args.tb}{'_' + bhash if bhash else ''}"):
        current_mtime = targetMtime(binary)
        if needs_compile and current_mtime == target_mtime:
            compile_cmd = f'cd {sim_dir}; {prefix} ./run_vcs compile {args.config} {args.testsuite} --wkdir {wkdir} {compile_flags}'
            rc = shell(compile_cmd)
            if rc:
                print(f"Error: VCS compilation failed for {args.config} {args.tb}", file=sys.stderr)
                return rc
    if checkCompiled(binary, "VCS"):
        return 1

    # Phase 2: Run the simulation
    run_flags = f"--tb {args.tb} {flags}"
    if args.args.strip():
        run_flags += f' --args "{args.args}"'
    run_cmd = f'cd {sim_dir}; {prefix} ./run_vcs run {args.config} {args.testsuite} --wkdir {wkdir} {run_flags}'
    return shell(run_cmd, successPattern(args))


def main(args):
    validateArgs(args)
    if args.tb == "testbench_fp":  # TestFloat names its test rather than running ELFs
        elfs = []
        args.testsuite = args.tests[0] if args.tests else args.name
    else:
        elfs, names = collectTests(args)
        # The testbench receives this as +TEST; it is the special mode when one is set, else the run name
        args.testsuite = args.test if args.test else runName(args, elfs, names)
    print(f"Config={args.config} test={args.testsuite} elfs={len(elfs)} sim={args.sim} gui={args.gui} args='{args.args}' params='{args.params}' define='{args.define}'")
    flags, prefix = prepSim(args, elfs)
    createDirs(args.sim)
    sys.exit(runSim(args, flags, prefix))


if __name__ == "__main__":
    args = parseArgs()
    main(args)
