# Tests that pass their own self-check but cannot be compared against ImperasDV instruction by
# instruction, because the reference model cannot be configured to match what Wally implements.
# Lockstep runs them without lockstep instead, so they still check themselves and add coverage.
# Each entry is the ELF file name, or the <directory>_<file> name used for the log.
lockstepwaivers = [
    "Zicbom-cbo.inval-00.elf", # ImperasDV lacks cache model to match CVW on invalidation

    # Wally implements writable mhpmevent bits; ImperasDV models them as read-only zero and offers no
    # parameter to change that, so every test that walks or writes mhpmevent disagrees.  The tests
    # themselves pass without lockstep.
    "Sm_mcsr_access-00.elf",
    "Sm_mcsr_walk-02.elf",
    "Sm_mcsr_walk-03.elf",
    "Sm_mcsr_walk-04.elf",
    "Sm_mcsr_walk-05.elf",
    "Sm_mcsr_walk-06.elf",
    "Sm_mcsr_walk-07.elf",
    "Sm_mcsr_walk-08.elf",
    "Sm_mcsr_walk-09.elf",
    "SsstrictSm_CSR-08.elf",   # writes mhpmevent3 (CSR 0x323); same mhpmevent limitation as above

    # ImperasDV accepts N=1 on a superpage leaf PTE instead of page faulting (riscv-arch-test does
    # not run Svnapot on Imperas for the same reason)
    "Svnapot_sv39_Svnapot_reserved_enc_Smode-00.elf",
    "Svnapot_sv39_Svnapot_reserved_enc_Umode-00.elf",
    "Svnapot_sv48_Svnapot_reserved_enc_Smode-00.elf",
    "Svnapot_sv48_Svnapot_reserved_enc_Umode-00.elf",
    "Svnapot_sv57_Svnapot_reserved_enc_Smode-00.elf",
    "Svnapot_sv57_Svnapot_reserved_enc_Umode-00.elf",

    # ImperasDV traps a wfi below M mode with mstatus.TW=1 at once, while Wally waits a bounded time
    # (WFI_TIMEOUT_BIT) before the illegal-instruction trap; both are legal (Privileged Spec
    # mstatus_tw_always_illegal vs mstatus_tw_op).  These tests depend on the wait, so lockstep mismatches.
    "wfiTW.elf",
    "wfitimeoutint.elf",
    "wfitimeoutnext.elf",
]

# tests for cache simulations on a rv64gc derived config - cache_rv64gc.  Each run logs the I$ and
# D$ accesses, and CacheSim.py replays them through a model of the caches.  {} stands for the run's
# log path without .log.  The testbench resets the core before each ELF, which the loggers record as
# TRAIN and CacheSim.py takes as an empty cache, so a run may hold several ELFs.
tests64gc_cache = [
    ["cache_rv64gc", "rv64gc",
    ["rv64i/I", "rv64i/M", "rv64i/Zca", "rv64i/Zcb", "rv64i/Zifencei", "rv64i/Zicond", "rv64i/Zaamo", "rv64i/Zalrsc",
     "rv64i/Zbkb", "rv64i/Zbkc", "rv64i/Zbkx", "rv64i/Zknd", "rv64i/Zkne", "rv64i/Zknh",
     "rv64i/Zba", "rv64i/Zbb", "rv64i/Zbc", "rv64i/Zbs", "priv/Sm", "priv/S", "priv/U", "priv/Sv"],
    '--args \'+sim_log_prefix={}_\' --params "I_CACHE_ADDR_LOGGER=1\\\'b1 D_CACHE_ADDR_LOGGER=1\\\'b1"',
    [["CacheSim.py", "64", "4", "56", "44", "-f", "{}_ICache.log", "-p"],
     ["CacheSim.py", "64", "4", "56", "44", "-f", "{}_DCache.log", "-p"]]
    ]
]


##################################
# Data Types & Functions
##################################

TestCase = namedtuple("TestCase", ['name', 'variant', 'cmd', 'log', 'grepstr', 'grepfile', 'altcommand', 'ucdb', 'elfs',
                                   'stderrToLog'],
                      defaults=[None, None, None, None, False])
# name:     the name of this test configuration (used in printing human-readable
#           output and picking logfile names)
# cmd:      the command to run, as an argument list (it runs without a shell)
# log:      the file the command's standard output is written to
# grepstr:  the string to search the log file for. The test succeeds iff the
#           string is found
# grepfile: the file to search instead of the log, if the success string goes elsewhere
# altcommand:  a list of commands (argument lists) that perform a validation check other than
#           searching the log, appending their output to the log; the test passes if they all succeed
# ucdb:     the coverage database the run writes, if it collects coverage; it is deleted before
#           the run and again if the run fails, so only passing runs contribute coverage
# elfs:     the ELFs a coverage run simulates, recorded next to its database (see coverageUpToDate)
# stderrToLog: also write the command's standard error to the log
class bcolors:
    HEADER = '\033[95m'
    OKBLUE = '\033[94m'
    OKCYAN = '\033[96m'
    OKGREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'

def addTests(testList, sim, coverStr, configs):
    sim_logdir = f"{regressionDir}/{sim}/logs/"
    for test in testList:
        config = test[0]
        suites = test[1]
        flags = f"{test[2]}" if len(test) >= 3 else ""
        gs = test[3] if (len(test) >= 4 and test[3] is not None) else "All tests ran without failures"
        for t in suites:
            sim_log_prefix = f"{sim_logdir}{config}_{t}"
            sim_log = f"{sim_log_prefix}.log"
            grepfile = sim_logdir + test[4] if (len(test) >= 5 and test[4] is not None) else None
            altcommand = [[a.format(sim_log_prefix) for a in c] for c in test[5]] if (len(test) >= 6 and test[5] is not None) else None
            tc = TestCase(
                    name=t,
                    variant=config,
                    cmd=["wsim", "--sim", sim, *coverStr.split(), *shlex.split(flags.format(sim_log_prefix)), config, t],
                    log=sim_log,
                    grepstr=gs,
                    grepfile=grepfile,
                    altcommand=altcommand)
            configs.append(tc)


def addTestsByDir(testDir, config, sim, coverStr, configs, lockstepMode=0, brekerMode=0, flags="", chunk=0):
    """Run every .elf under testDir on config.

    Each leaf directory becomes one test case: wsim runs all of its ELFs back-to-back in a single
    simulation session, so the design compiles once and the simulator starts once per directory.
    Lockstep and Breker need a fresh reference model per ELF, so they run one simulation per ELF.
    With chunk, a directory holding more ELFs than that is split into simulations of at most chunk
    ELFs, so that one large directory does not set the length of the whole run.  A coverage run
    whose database is up to date (coverageUpToDate) is not run again."""
    if not os.path.isdir(testDir):
        print(f"Error: Directory not found: {testDir}")
        sys.exit(1)

    sim_logdir = f"{regressionDir}/{sim}/logs/"
    cmdPrefix = ["wsim", "--sim", sim, *coverStr.split(), *shlex.split(flags), config]
    passed = "All tests ran without failures"
    if lockstepMode:
        gs = "Mismatches            : 0"
    elif brekerMode:
        gs = "# trek: info: summary: Test PASSED"
    else:
        gs = passed
    reused = []
    for dirpath, _, filenames in sorted(os.walk(os.path.abspath(testDir))):
        elfs = sorted(f for f in filenames if f.endswith(".elf"))
        if not elfs:
            continue
        parent, leaf = dirpath.rsplit('/', 2)[-2:]
        if lockstepMode or brekerMode:
            for file in elfs:
                shortelf = f"{leaf}_{file}"
                elf = f"{dirpath}/{file}"
                ucdb = coverageDatabase(coverStr, config, f"{leaf}_{file[:-4]}")
                if coverageUpToDate(ucdb, [elf]):
                    reused.append(shortelf)
                    keptCoverage.add(ucdb)
                    continue
                # ImperasDV cannot be configured to match these tests, so they run without lockstep and
                # only check themselves
                waived = lockstepMode and (shortelf in lockstepwaivers or file in lockstepwaivers)
                if waived:
                    print(f"{bcolors.WARNING}Running waived test {shortelf} without lockstep{bcolors.ENDC}")
                sim_log = f"{sim_logdir}{config}_{shortelf}.log"
                configs.append(TestCase(name=file, variant=config,
                                        cmd=[*cmdPrefix, *([] if waived or not lockstepMode else ["--lockstep"]), elf],
                                        log=sim_log, grepstr=passed if waived else gs, ucdb=ucdb, elfs=(elf,)))
        else:
            name = f"{parent}_{leaf}" # matches the name wsim derives for a directory
            paths = [f"{dirpath}/{e}" for e in elfs]
            if chunk and len(paths) > chunk:
                runs = [(f"{name}_{n}", paths[i:i + chunk]) for n, i in enumerate(range(0, len(paths), chunk))]
            else:
                runs = [(name, paths)]
            for runname, group in runs:
                ucdb = coverageDatabase(coverStr, config, runname)
                if coverageUpToDate(ucdb, group):
                    reused.append(runname)
                    keptCoverage.add(ucdb)
                    continue
                target = [dirpath] if len(runs) == 1 else [*group, "--name", runname]
                sim_log = f"{sim_logdir}{config}_{runname}.log"
                configs.append(TestCase(name=runname, variant=config, cmd=[*cmdPrefix, *target], log=sim_log,
                                        grepstr=gs, ucdb=ucdb, elfs=tuple(group)))
    if reused:
        print(f"{bcolors.OKCYAN}{config}: reusing coverage for {len(reused)} up-to-date runs in {os.path.basename(testDir)}{bcolors.ENDC}")


def addActTests(testList, sim, coverStr, configs):
    """Run configurations on the ACT ELFs of the configuration they are derived from.

    Each entry is [config, base, suites], optionally followed by flags for wsim and a list of commands
    (argument lists) that check the run instead of its log; {} in either stands for the run's log path
    without .log.  A suite is a leaf directory under the base's ACT ELF directory, or a glob of ELFs
    within one, and each suite runs as one simulation.  A suite that matches no ELF is an error, so a
    renamed ACT directory cannot silently drop tests."""
    sim_logdir = f"{regressionDir}/{sim}/logs/"
    for test in testList:
        config, base, suites = test[0], test[1], test[2]
        flags = test[3] if len(test) > 3 else ""
        checks = test[4] if len(test) > 4 else None
        elfDir = actElfDir(base)
        for suite in suites:
            pattern = f"{elfDir}/{suite}.elf" if glob.has_magic(suite) else f"{elfDir}/{suite}/*.elf"
            elfs = sorted(glob.glob(pattern))
            if not elfs:
                print(f"{bcolors.FAIL}Error: no ACT ELFs match {pattern}{bcolors.ENDC}")
                sys.exit(1)
            name = re.sub(r"[^\w.-]", "", suite.replace("/", "_"))
            prefix = f"{sim_logdir}{config}_{name}"
            configs.append(TestCase(name=name, variant=config,
                                    cmd=["wsim", "--sim", sim, *coverStr.split(), *shlex.split(flags.format(prefix)),
                                         config, *elfs, "--name", name],
                                    log=f"{prefix}.log", grepstr="All tests ran without failures",
                                    altcommand=[[a.format(prefix) for a in c] for c in checks] if checks else None,
                                    elfs=tuple(elfs)))


def addTestGroup(name, testDir, tests, config, sim, coverStr, configs, flags=""):
    """Run the listed ELFs (paths relative to testDir, .elf optional) back-to-back in one simulation."""
    sim_logdir = f"{regressionDir}/{sim}/logs/"
    elfs = [f"{testDir}/{t}{'' if t.endswith('.elf') else '.elf'}" for t in tests]
    configs.append(TestCase(name=name, variant=config,
                            cmd=["wsim", "--sim", sim, *coverStr.split(), *shlex.split(flags), config, *elfs, "--name", name],
                            log=f"{sim_logdir}{config}_{name}.log", grepstr="All tests ran without failures",
                            elfs=tuple(elfs)))


# Coverage is collected one .ucdb per simulation and merged at the end, so a simulation whose .ucdb
# is already newer than its ELFs and than everything that shapes coverage, and was collected from
# the same ELFs, does not need to run again.  Set by prepareCoverage.
reuseCoverage = False
fcovRun = False
_inputsMtime = None
keptCoverage = set()  # reused .ucdb files; with the ones the selected tests write, the only ones merged


def coverageDatabase(coverStr, config, name):
    """The coverage database a run named <config>_<name> writes, or None: a .ucdb file from Questa
    (see wally-run.do) or a .vdb directory from VCS (see run_vcs)."""
    ext = ".vdb" if coveragesim == "vcs" else ".ucdb"
    if "--ccov" in coverStr:
        return f"{regressionDir}/{coveragesim}/ucdb/{config}_{name}{ext}"
    if "--fcov" in coverStr:
        return f"{regressionDir}/{coveragesim}/fcov_ucdb/{config}_{name}{ext}"
    return None


def coverageMtime(db):
    """When a coverage database was completed, or None if there is no complete one.  run_vcs creates
    a .vdb directory before the simulation starts; the simulation adds its results under testdata
    only when it finishes, so an interrupted run leaves a .vdb without them."""
    if db.endswith(".vdb"):
        results = glob.glob(f"{db}/snps/coverage/db/testdata/*")
        return max(os.path.getmtime(r) for r in results) if results else None
    return os.path.getmtime(db) if os.path.isfile(db) else None


def removeCoverage(db):
    """Remove a coverage database (a .ucdb file or a .vdb directory) and its record of ELFs."""
    if os.path.isdir(db):
        shutil.rmtree(db, ignore_errors=True)
    elif os.path.exists(db):
        os.remove(db)
    if os.path.exists(f"{db}.elfs"):
        os.remove(f"{db}.elfs")


def coverageInputsMtime():
    """Newest mtime among everything that shapes a run's coverage: the design and testbench sources,
    the ImperasDV configurations (.ic), and the coverage simulator's scripts that compile and run the
    tests, plus, for functional coverage, the riscv-arch-test covergroups and the sources they include.
    The code coverage exclusions are applied to the merged database (sim/Makefile), so editing them
    does not require rerunning the tests."""
    global _inputsMtime
    if _inputsMtime is None:
        dirs = [f"{WALLY}/{d}" for d in ("src", "testbench", "config")]
        if fcovRun:
            dirs += [f"{archVerifDir}/{d}" for d in ("coverpoints", "framework/src/act/fcov", "tests/env")]
        scripts = ("run_vcs", "coverage.hier") if coveragesim == "vcs" else ("wally-compile.do", "wally-run.do")
        _inputsMtime = max(os.path.getmtime(f"{regressionDir}/{coveragesim}/{f}") for f in scripts)
        for d in dirs:
            for root, _, files in os.walk(d):
                for f in files:
                    if f.endswith((".sv", ".v", ".svh", ".vh", ".h", ".ic")):
                        _inputsMtime = max(_inputsMtime, os.path.getmtime(os.path.join(root, f)))
    return _inputsMtime


def coverageTools():
    """Versions of the tools that produce coverage, so coverage from other versions is not reused."""
    if coveragesim == "vcs":
        urg = shutil.which("urg")
        out = subprocess.run([urg, "-full64", "-version"], capture_output=True, text=True).stdout if urg else ""
        version = "".join(line for line in out.splitlines(keepends=True) if "ersion" in line).strip()
        sim = f"VCS_HOME={os.path.realpath(os.environ.get('VCS_HOME', ''))}\n{version}"
    else:
        vsim = shutil.which("vsim")
        sim = subprocess.run([vsim, "-version"], capture_output=True, text=True).stdout.strip() if vsim else ""
    imperas = os.path.realpath(os.environ.get("IMPERAS_HOME", ""))
    return f"{sim}\nIMPERAS_HOME={imperas}\n"


def elfList(elfs):
    """The record of the ELFs a coverage database was collected from, kept in <database>.elfs."""
    return "".join(f"{elf}\n" for elf in elfs)


def coverageUpToDate(ucdb, elfs):
    """True if the coverage database ucdb was collected from exactly these ELFs and is newer than each
    of them and than every input that shapes coverage."""
    if not (reuseCoverage and ucdb and os.path.isfile(f"{ucdb}.elfs")):
        return False
    with open(f"{ucdb}.elfs") as f:
        if f.read() != elfList(elfs):
            return False
    mtime = coverageMtime(ucdb)
    return mtime is not None and mtime > coverageInputsMtime() and all(mtime > os.path.getmtime(elf) for elf in elfs)


def prepareCoverage(coverStr, clean, dryrun):
    """Coverage is per simulation, so an unchanged simulation's database is still valid: keep the
    databases and rerun only what is out of date.  --clean discards them all and starts over, except
    in a dry run, which must not discard the coverage of an earlier run."""
    global reuseCoverage, fcovRun
    fcovRun = "--fcov" in coverStr
    ucdbDir, reportDir = [f"{regressionDir}/{coveragesim}/{d}" for d in (("fcov_ucdb", "fcov") if fcovRun else ("ucdb", "cov"))]
    reuseCoverage = not clean
    toolsFile = f"{ucdbDir}/.tools"
    tools = coverageTools()
    if reuseCoverage and os.path.isfile(toolsFile) and open(toolsFile).read() != tools:
        print(f"{bcolors.WARNING}{coveragesim} or ImperasDV changed since the coverage was collected; rerunning every test{bcolors.ENDC}")
        reuseCoverage = False
    for d in [ucdbDir, reportDir]:
        if not reuseCoverage and not dryrun:
            shutil.rmtree(d, ignore_errors=True)
        os.makedirs(d, exist_ok=True)
    if not dryrun:
        with open(toolsFile, "w") as f:
            f.write(tools)


def actElfDir(config):
    """Where ACT puts the ELFs for a cvw configuration (work/<name>/elfs; name is cvw-<config>)."""
    return f"{archVerifDir}/work/cvw-{config}/elfs"


builtTargets = set()


def buildTests(periph=True, coverage=False, deriv=False, testfloat=False):
    """Build the tests with the root Makefile, which rebuilds only what is out of date: the ACT ELFs
    for every configuration with an ACT configuration, the boot image a 64-bit IROM (rv64i) is
    preloaded from (zsbl), and optionally the peripheral and coverage tests, the derivative
    configurations (config/deriv) and the testfloat vectors."""
    targets = [t for t in ["act", "zsbl"] + (["periph"] if periph else []) + (["coverage"] if coverage else [])
               + (["deriv"] if deriv else []) + (["testfloat"] if testfloat else []) if t not in builtTargets]
    if not targets:
        return
    # ACT is its own uv project: drop the VIRTUAL_ENV that `uv run` set for this script so ACT's
    # uv uses ACT's environment without warning about the mismatch
    env = {k: v for k, v in os.environ.items() if k != "VIRTUAL_ENV"}
    print(f"Building tests: make -C {WALLY} {' '.join(targets)}", flush=True)
    if subprocess.run(["make", "-C", WALLY, *targets], env=env).returncode:
        print(f"{bcolors.FAIL}Error: building {' '.join(targets)} failed{bcolors.ENDC}")
        sys.exit(1)
    builtTargets.update(targets)


def search_log_for_text(text, grepfile):
    with open(grepfile, errors="ignore") as file:
        content = file.readlines()
        passed = False
        numpassed = 0 # a log holds many tests run back-to-back, so summarize the passes in one line
        reported = False # whether any line identifying this test was printed
        success = any(text in line for line in content) # check if the success string is present in the log file
        # Even if the string is found, report warnings, errors, and failure, or PASSED
        for line in content:
            if rvcp_summary in line:
                if "FAILED" in line:
                    print(f"{bcolors.FAIL}{grepfile}: {line.strip()}{bcolors.ENDC}")
                    success = False
                    reported = True
                elif "PASSED" in line:
                    passed = True
                    numpassed += 1
                else:
                    print(f"{bcolors.WARNING}{grepfile}: WARNING: Malformed {rvcp_summary} line lacks FAILED or PASSED: {line.strip()}{bcolors.ENDC}")
            if "warning:" in line.lower():
                print(f"{bcolors.WARNING}{grepfile}: {line.strip()}{bcolors.ENDC}")
                success = False
                reported = True
            if "error:" in line.lower():
                print(f"{bcolors.FAIL}{grepfile}: {line.strip()}{bcolors.ENDC}")
                success = False
                reported = True
        nonrvcp_suites = ["buildroot", "all_lints", "periph", "coverage", "embench", "coremark"]
        if numpassed:
            print(f"{bcolors.OKGREEN}{grepfile}: {numpassed} {rvcp_summary} PASSED{bcolors.ENDC}")
        if success and not passed:
            if not any(s in grepfile for s in nonrvcp_suites):
                print(f"{bcolors.WARNING}{grepfile}: WARNING '{text}' found but no {rvcp_summary} PASSED{bcolors.ENDC}")
        if not success and passed:
            print(f"{bcolors.WARNING}{grepfile}: WARNING No success string '{text}' found in log file{bcolors.ENDC}")
            reported = True
        if not success and not reported:
            # Otherwise-silent failure (e.g. lockstep mismatch: ImperasDV prints "Error (IDV)"
            # without a colon, so the error: check above misses it); name the failing log
            print(f"{bcolors.FAIL}{grepfile}: FAIL: success string '{text}' not found{bcolors.ENDC}")
        return 0 if success else 1


def run_test_case(config, dryrun: bool = False, timeout=None):
    """Run one test case; 0 if it passed.  The command runs in its own process group so that a
    timeout stops the simulator it started too.  A coverage run's database is removed first and again
    if the run fails, so a failing or interrupted run never contributes coverage; a passing run
    records the ELFs it was collected from next to it."""
    if dryrun:
        print(f"Executing {shlex.join(config.cmd)} > {config.log}", flush=True)
        return 0
    if config.ucdb:
        removeCoverage(config.ucdb)
    failed = run_test_command(config, timeout)
    if config.ucdb and os.path.exists(config.ucdb):
        if failed:
            removeCoverage(config.ucdb)
        else:
            with open(f"{config.ucdb}.elfs", "w") as f:
                f.write(elfList(config.elfs or ()))
    return failed


def run_test_command(config, timeout):
    """Run the test command and check its log; 1 if it failed or timed out."""
    grepfile = config.grepfile or config.log
    cmd = shlex.join(config.cmd)
    with open(config.log, "w") as log:
        try:
            proc = subprocess.Popen(config.cmd, stdout=log, stderr=subprocess.STDOUT if config.stderrToLog else None,
                                    start_new_session=True)
        except OSError as e:
            print(f"{bcolors.FAIL}{cmd}: {e}{bcolors.ENDC}", flush=True)
            return 1
        try:
            ret_code = proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)  # the command, the simulator, and anything they started
            except ProcessLookupError:
                pass
            proc.wait()
            print(f"{bcolors.FAIL}{cmd}: Timeout - runtime exceeded {timeout} seconds{bcolors.ENDC}", flush=True)
            return 1
    if ret_code != 0:
        print(f"{bcolors.FAIL}{cmd}: Execution failed{bcolors.ENDC}", flush=True)
        print(f"  Check {grepfile} for more details.", flush=True)
        return 1
    elif config.altcommand:
        with open(config.log, 'a') as f:
            if all(subprocess.run(c, stdout=f, stderr=subprocess.STDOUT).returncode == 0 for c in config.altcommand):
                # Success message
                print(f"{bcolors.OKGREEN}{cmd}: Success{bcolors.ENDC}", flush=True)
                f.write("Tests completed with 0 errors\n")  # Write success message to the log
                return 0
            else:
                # Failure message
                print(f"{bcolors.FAIL}{cmd}: Failures detected in output. Check {config.log}.{bcolors.ENDC}", flush=True)
                f.write("ERROR: There is a difference detected in the output\n")  # Write failure message to the log
                return 1
    failed = search_log_for_text(config.grepstr, grepfile)
    return 1 if unreported_elfs(config, grepfile) or failed else 0


def unreported_elfs(config, logfile):
    """In a simulation of several ELFs, the testbench reports each one as it finishes, so an ELF that
    hangs ends the session and leaves it and the ELFs after it unreported.  Name them; True if any."""
    if len(config.elfs or ()) < 2 or config.grepstr != "All tests ran without failures":
        return False
    with open(logfile, errors="ignore") as f:
        reported = {os.path.basename(line.split()[-3]) for line in f
                    if line.rstrip().endswith(("succeeded.  Brilliant!!!", "failed. :(")) and len(line.split()) >= 3}
    missing = [elf for elf in config.elfs if os.path.basename(elf) not in reported]
    if missing:
        print(f"{bcolors.FAIL}{logfile}: {len(missing)} ELFs did not finish, starting with "
              f"{os.path.basename(missing[0])}{bcolors.ENDC}", flush=True)
    return bool(missing)

def parse_args():
    parser = argparse.ArgumentParser()
    parser.add_argument("--ccov", help="Code Coverage", action="store_true")
    parser.add_argument("--clean", help="With --ccov or --fcov, discard existing coverage and rerun every test", action="store_true")
    parser.add_argument("--fcov", help="Functional Coverage", action="store_true")
    parser.add_argument("--coveragesim", help="Simulator for --ccov and --fcov", choices=["questa", "vcs"], default="questa")
    parser.add_argument("--nightly", help="Run large nightly regression", action="store_true")
    parser.add_argument("--buildroot", help="Include Buildroot Linux boot test (takes many hours, done along with --nightly)", action="store_true")
    parser.add_argument("--testfloat", help="Include Testfloat floating-point unit tests", action="store_true")
    parser.add_argument("--branch", help="Run branch predictor accuracy tests", action="store_true")
    parser.add_argument("--breker", help="Run Breker tests", action="store_true") # Requires a license for the breker tool. See tests/breker/README.md for details
    parser.add_argument("--dryrun", help="Print commands invoked to console without running regression", action="store_true")
    parser.add_argument("--benchmark", help="Check for performance changes or discrepancies in embench and coremark", action="store_true")
    parser.add_argument("--cache", help="Run cache performance validation tests", action="store_true")
    return parser.parse_args()


def process_args(args):
    global coveragesim
    coveragesim = args.coveragesim
    coverStr = ""
    # exercise all simulators in nightly; can omit a sim if no license is available
    sims = ["questa", "verilator", "vcs"] if args.nightly else [defaultsim]
    if args.ccov:
        sims = [coveragesim]
        coverStr = "--ccov"
        TIMEOUT_DUR = 20*60 # seconds
    elif args.fcov or args.breker:
        sims = [coveragesim]
        coverStr = "--fcov"
        TIMEOUT_DUR = 60*60 # per simulation; functional coverage splits large directories (see selectTests)
    elif args.buildroot:
        TIMEOUT_DUR = 60*3600 # 2.5 days
    elif args.testfloat:
        sims = [testfloatsim]
        TIMEOUT_DUR = 60*60 # seconds; the fma tests of the largest FPUs take more than half an hour
    elif args.branch or args.cache:
        TIMEOUT_DUR = 120*60 # seconds
    elif args.nightly or args.benchmark:
        TIMEOUT_DUR = 60*60 # seconds
    else:
        TIMEOUT_DUR = 10*60 # seconds
    if coverStr:
        prepareCoverage(coverStr, args.clean, args.dryrun)

    return sims, coverStr, TIMEOUT_DUR


def selectTests(args, sims, coverStr):
    # Run Lint
    configs = [
        TestCase(
            name="lints",
            variant="all",
            cmd=["lint-wally", *(["--nightly"] if args.nightly else [])],
            log=f"{regressionDir}/verilator/logs/all_lints.log",
            grepstr="All lints passed with no errors or warnings")
        ]

    # run full buildroot boot simulation (slow) if buildroot flag is set.  Start it early to overlap with other tests
    if args.buildroot:
        # addTests(tests_buildrootboot, defaultsim) # non-lockstep with Verilator runs in about 2 hours
        addTests(tests_buildrootbootlockstep, lockstepsim, coverStr, configs) # lockstep with Questa and ImperasDV runs overnight
    # Coverage runs are for verification rather than regression, so every ELF runs in lockstep
    # against the reference model (one simulation per ELF).
    # code coverage: rv64gc runs the ACT tests, the coverage-targeted tests, and the peripheral tests
    if args.ccov:
        buildTests(coverage=True)
        addTestsByDir(actElfDir("rv64gc"), "rv64gc", coveragesim, coverStr, configs, lockstepMode=1)
        addTestsByDir(coverageDir, "rv64gc", coveragesim, coverStr, configs, lockstepMode=1)
        addTestsByDir(f"{periphDir}/rv64", "rv64gc", coveragesim, coverStr, configs, lockstepMode=1)
    # functional coverage: rv64gc runs the ACT tests, one leaf directory per simulation.
    # Unlike code coverage this cannot run in lockstep: the covergroups read the virtual memory
    # fields of riscv-arch-test's RVVI trace, while ImperasDV needs the RVVI API tasks of its own,
    # and only one of the two interfaces can be compiled in.  The tests still check themselves.
    # Not in nightly: its standard block already runs these directories on Questa, and a second
    # copy would race it for the same log and testlist files.
    if args.fcov:
        buildTests(periph=False)
        # Functional coverage slows the simulation to between half a minute and two minutes per
        # ELF (the Ssstrict tests are the slowest), so split each directory into simulations of at
        # most 8 ELFs
        addTestsByDir(actElfDir("rv64gc"), "rv64gc", coveragesim, coverStr, configs, chunk=8)
     # run branch predictor tests
    if args.branch:
        addTests(bpredtests, defaultsim, coverStr, configs)
    # run Breker tests (requires a license for the breker tool)
    if args.breker:
        addTestsByDir(f"{WALLY}/tests/breker/work", "rv64breker", "questa", coverStr, configs, brekerMode=1)
    # standard tests: build the ACT ELFs for every configuration, then run each leaf directory of
    # ACT tests as one simulation, plus the peripheral tests for the configurations that have them.
    # Directories of more than 25 ELFs are split so that the largest ones do not set the length of the
    # run: one simulation per ELF finishes no sooner on a large host and takes far longer on a small one.
    if not(args.testfloat or args.ccov or args.fcov or args.cache or args.branch or args.benchmark or args.breker):
        buildTests()
        for sim in sims:
            if not (args.buildroot and sim == lockstepsim):  # skip short buildroot sim if running long one
                addTests(tests_buildrootshort, sim, coverStr, configs)
            for config in standard_configs:
                addTestsByDir(actElfDir(config), config, sim, coverStr, configs, chunk=25)
                if config in periph_tests:
                    addTestGroup("periph", periphDir, periph_tests[config], config, sim, coverStr, configs)
    # run derivative configurations and lockstep tests in nightly regression
    if args.nightly:
        buildTests(periph=False, coverage=True, deriv=True)
        addTestsByDir(coverageDir, "rv64gc", lockstepsim, coverStr, configs, lockstepMode=1)
        addTestsByDir(actElfDir("rv64gc"), "rv64gc", lockstepsim, coverStr, configs, lockstepMode=1)
        addTestsByDir(actElfDir("rv32gc"), "rv32gc", lockstepsim, coverStr, configs, lockstepMode=1)
        addTestsByDir(coverage32Dir, "rv32gc", lockstepsim, coverStr, configs, lockstepMode=1)
        addActTests(derivconfigtests, defaultsim, coverStr, configs)
        for config, tests in deriv_coverage_tests.items():
            addTestGroup("coverage", coverageDir, tests, config, defaultsim, coverStr, configs)
        # addTests(bpredtests, defaultsim) # This is currently broken in regression due to something related to the new wsim script.
    # testfloat tests
    if (args.testfloat or args.nightly): # for nightly, run testfloat along with others
        buildTests(periph=False, deriv=True, testfloat=True)
        testfloatconfigs = ["fdqh_rv64gc", "fdq_rv64gc", "fdh_rv64gc", "fd_rv64gc", "fh_rv64gc", "f_rv64gc", "fdqh_rv32gc", "f_rv32gc"]
        for config in testfloatconfigs + testfloatdivconfigs:
            tests = ["div", "sqrt", "cvtint", "cvtfp"]
            if config in testfloatconfigs:
                tests.extend(["add", "sub", "mul", "fma", "cmp"])
            if "f_" in config:
                tests.remove("cvtfp")
            for test in tests:
                sim_log = f"{regressionDir}/{testfloatsim}/logs/{config}_{test}.log"
                tc = TestCase(
                        name=test,
                        variant=config,
                        cmd=["wsim", "--tb", "testbench_fp", "--sim", testfloatsim, config, test],
                        log=sim_log,
                        grepstr="All Tests completed with          0 errors")
                configs.append(tc)

    if (args.benchmark or args.nightly):
        # RUNNING THE EMBENCH TEST
        embench_dir = f"{WALLY}/benchmarks/embench/"
        actual_embench_directory = f"{embench_dir}/actual_embench_results/"
        expected_embench_directory = f"{embench_dir}/expected_embench_results/"
        embench_logfile_path = f"{embench_dir}/run.log"
        # finds any differences between the two embench directories and appends them to the log file
        embench_test = TestCase(
            name="embench",
            variant="rv32gc",
            cmd=["make", "-C", f"{WALLY}/benchmarks/embench", "run"],
            log=embench_logfile_path,
            grepstr=None,  # the diff in altcommand decides
            altcommand=[["diff", "-ru", actual_embench_directory, expected_embench_directory]]
        )
        configs.append(embench_test)


        # RUNNING THE COREMARK TEST
        coremark_logfile_path = f"{regressionDir}/{defaultsim}/logs/validation.log"
        coremark_dir = f"{WALLY}/benchmarks/coremark/"
        coremark_sweep_test_file = f"{coremark_dir}coremark_sweep.py"
        actual_coremark_values_csv = f"{coremark_dir}coremark_results.csv"
        expected_coremark_values_csv = f"{coremark_dir}expected_coremark_results.csv"

        # calculates the difference between the coremark expected outcomes and appends them to the log file
        coremark_test = TestCase(
            name="validate_coremark_sweep",
            variant="coremark check",
            cmd=["python3", coremark_sweep_test_file],
            log=coremark_logfile_path,
            grepstr=None,  # the diff in altcommand decides
            stderrToLog=True,
            altcommand=[["diff", "-u", actual_coremark_values_csv, expected_coremark_values_csv]]
        )
        configs.append(coremark_test)

    if (args.cache or args.nightly):
        # RUNNING THE CACHE TESTS FOR RV64GC
        buildTests(periph=False, deriv=True)
        addActTests(tests64gc_cache, defaultsim, coverStr, configs)

    return configs


def makeDirs(sims):
    # Clear old logs.  Compiled designs in wkdir are kept; wsim recompiles them only when a source
    # file is newer than the compiled design.
    # Always need verilator directories for lint
    for sim in (sims + ["verilator"] if "verilator" not in sims else sims):
        logdir = f"{regressionDir}/{sim}/logs"
        shutil.rmtree(logdir, ignore_errors=True)
        os.makedirs(logdir, exist_ok=True)
        os.makedirs(f"{regressionDir}/{sim}/wkdir", exist_ok=True)


def main(args):
    unmigrated = [f"--{mode} ({what})" for mode, what in unmigratedModes.items() if getattr(args, mode)]
    if unmigrated:
        print(f"{bcolors.FAIL}Error: {', '.join(unmigrated)} not available yet: migration of these tests "
              f"to riscv-arch-test is still in progress{bcolors.ENDC}", file=sys.stderr)
        return 1
    startTime = time.time()
    sims, coverStr, TIMEOUT_DUR = process_args(args)
    makeDirs(sims)
    configs = selectTests(args, sims, coverStr)
    if coverStr and not args.dryrun:
        # Merge only coverage that belongs to the tests selected now: drop the .ucdb of any test that
        # was renamed, removed, or run by hand outside the regression.
        current = keptCoverage | {c.ucdb for c in configs if c.ucdb}
        merged = {f"{regressionDir}/questa/ucdb/cov.ucdb", f"{regressionDir}/questa/fcov_ucdb/fcov.ucdb"}  # sim/Makefile writes these
        ext = ".vdb" if coveragesim == "vcs" else ".ucdb"
        ucdbDir = f"{regressionDir}/{coveragesim}/{'fcov_ucdb' if fcovRun else 'ucdb'}"
        stale = [f for f in glob.glob(f"{ucdbDir}/*{ext}") if f not in current and f not in merged]
        for f in stale:
            removeCoverage(f)
        if stale:
            print(f"{bcolors.OKCYAN}Removed {len(stale)} coverage databases that no selected test writes{bcolors.ENDC}")
    # Scale the number of concurrent processes to the number of test cases, but
    # max out at a limited number of concurrent processes to not overwhelm the system
    # lockstep tests (nightly, ccov, fcov) each hold an ImperasDV license
    ImperasDVLicenseCount = 16 if (args.nightly or args.ccov or args.fcov) else 10000
    with Pool(processes=min(len(configs),multiprocessing.cpu_count(), ImperasDVLicenseCount)) as pool:
        num_fail = 0
        # Start the simulations of the most ELFs first, so that the longest ones do not start last; runs
        # that are not lists of ELFs (lint, buildroot, testfloat) keep their place at the front
        configs.sort(key=lambda c: -len(c.elfs) if c.elfs else -1e9)
        results = [pool.apply_async(run_test_case, (config, args.dryrun, TIMEOUT_DUR)) for config in configs]
        for result in results:
            num_fail += result.get() # each test enforces its own timeout
    # A run that passed but left no coverage database would silently lower the merged coverage
    if (args.ccov or args.fcov) and not args.dryrun:
        missing = [c for c in configs if c.ucdb and coverageMtime(c.ucdb) is None]
        for c in missing:
            print(f"{bcolors.FAIL}{c.cmd}: no coverage database {c.ucdb}{bcolors.ENDC}")
        if missing:
            print(f"{bcolors.FAIL}The merged coverage leaves out the {len(missing)} runs above{bcolors.ENDC}")

    # Coverage report; a merge or exclusion failure means the report cannot be trusted
    prefix = "Vcs" if coveragesim == "vcs" else "Questa"
    for enabled, target in ((args.ccov, f"{prefix}CodeCoverage"), (args.fcov, f"{prefix}FunctCoverage")):
        if enabled and not args.dryrun and subprocess.run(["make", "-C", regressionDir, target]).returncode:
            print(f"{bcolors.FAIL}make {target} failed{bcolors.ENDC}")
            num_fail += 1
    # Count the number of failures
    if num_fail:
        print(f"{bcolors.FAIL}Regression failed with {num_fail} failed configurations{bcolors.ENDC}")
    else:
        print(f"{bcolors.OKGREEN}SUCCESS! All tests ran without failures{bcolors.ENDC}")
    # Always report the total runtime
    elapsed = time.time() - startTime
    print(f"Total runtime: {int(elapsed // 3600)}h {int(elapsed % 3600 // 60)}m {elapsed % 60:.1f}s ({elapsed:.1f} seconds)")
    return num_fail

if __name__ == '__main__':
    args = parse_args()
    sys.exit(main(args))
