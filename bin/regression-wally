# Regression modes whose test lists below still name the old tests.vh suites.  Until they are
# converted to run ACT directories filtered by the extensions each configuration supports, the
# regression refuses them rather than failing every test with "Test not found".
unmigratedModes = {
    "branch": "branch predictor tests (bpredtests)",
}

# Derivative configurations run the ACT ELFs of the base configuration they are derived from
# (addActTests).  Each entry is [config, base, suites]: a suite is an ACT leaf directory under the
# base's ELF directory, or a glob of the ELFs in one (e.g. "rv64i/F/F-fdiv*") where the derivative
# lacks an extension that other tests in the directory need.  The suites exercise what each
# derivative changes.
def _fdiv(i):
    """The divide and square root tests of an XLEN's ACT directories (i is rv32i or rv64i)."""
    return [f"{i}/F/F-fdiv*", f"{i}/F/F-fsqrt*", f"{i}/D/D-fdiv*", f"{i}/D/D-fsqrt*", f"{i}/M"]


