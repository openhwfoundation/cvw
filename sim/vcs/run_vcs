import argparse
import glob
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

# Global variables
WALLY  = os.environ.get("WALLY")
simdir = f"{WALLY}/sim/vcs"
cfgdir = f"{WALLY}/config"
srcdir = f"{WALLY}/src"
tbdir  = f"{WALLY}/testbench"
logdir = f"{simdir}/logs"
actdir = f"{WALLY}/addins/riscv-arch-test"

# Code coverage metrics, chosen to match Questa's +cover=sbecf (see wally-compile.do):
#   line   statements (s); -cm_line contassign also counts continuous assignments, as Questa does
#   branch if/case arms and ?: operators (b)
#   cond   conditions in if statements and expressions in assignments (c, e).  The default mode counts
#          logical operators and bitwise operators on 1-bit operands, which is what Wally's logic is
#          written with; -cm_cond allops would add a condition for every bit of every vector bitwise
#          operation (tens of thousands), which Questa does not count either.  -cm_cond obs counts a
#          subexpression's vector only when it is observable at the output of the whole expression,
#          as Questa's focused expression coverage does, so that the two report the same holes and
#          exclusions2el can carry Questa's row exclusions over.
#   fsm    state machine states and transitions (f)
# Toggle coverage (Questa's t) is not collected, as with Questa.  -cm_noconst leaves out what a constant,
# such as a configuration parameter, makes unreachable (the XLEN=32 arm of an if (P.XLEN == 64)), which
# Questa's optimizer removes before it counts coverage.
CCOV_METRICS = "line+cond+branch+fsm"
CCOV_COMPILE = ["-cm", CCOV_METRICS, "-cm_line", "contassign", "-cm_cond", "obs", "-cm_noconst", "-cm_hier", f"{simdir}/coverage.hier"]

# Memories that are generated per FPGA target rather than compiled into the simulation
EXCLUDED_SOURCES = {f"{srcdir}/generic/mem/{name}.sv" for name in
                    ("rom1p1r_128x64", "ram2p1r1wbe_128x64", "rom1p1r_128x32", "ram2p1r1wbe_2048x64")}

def svFiles(directory):
    """Every .sv file under directory, as a sorted list of paths."""
    return sorted(str(f) for f in Path(directory).rglob("*.sv") if str(f) not in EXCLUDED_SOURCES)

def parseArgs():
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=["compile", "run"], help="Action to perform")
    parser.add_argument("config", help="Configuration file")
    parser.add_argument("testsuite", help="Test suite (or none, when running a single ELF file) ")
    parser.add_argument("--tb", "-t", help="Testbench", choices=["testbench", "testbench_fp"], default="testbench")
    parser.add_argument("--wkdir", "-w", help="Work directory path", default="")
    parser.add_argument("--args", "-a", help="Optional arguments passed to simulator via $value$plusargs", default="")
    parser.add_argument("--params", "-p", help="Optional top-level parameter overrides of the form param=value", default="")
    parser.add_argument("--define", "-d", help="Optional define macros passed to simulator", default="")
    parser.add_argument("--lockstep", "-l", help="Run ImperasDV lock, step, and compare.", action="store_true")
    parser.add_argument("--breker", "-b", help="Run Breker test", action="store_true")
    parser.add_argument("--ccov", "-c", help="Code coverage of testbench.dut.core", action="store_true")
    parser.add_argument("--fcov", "-f", help="Functional coverage: compile in the riscv-arch-test covergroups", action="store_true")
    return parser.parse_args()

def generateFileList(testbench, params):
    files = [f"{tbdir}/{testbench}.sv", *svFiles(srcdir), *svFiles(f"{tbdir}/common")]
    # Only the synthesizable RVVI interface (wsim --rvvi) uses the verilog-ethernet MAC
    if "RVVI_SYNTH_SUPPORTED=1" in params.split():
        files += svFiles(f"{WALLY}/addins/verilog-ethernet")
    return files

def getCompileOptions(wkdir, args):
    """Build compile-time options for VCS."""
    compileOptions = []
    if args.ccov:
        compileOptions.extend(CCOV_COMPILE)
    if args.fcov:
        compileOptions.extend(fcovCompileOptions(args.config))
    if args.lockstep:
        imperas = os.environ.get("IMPERAS_HOME", "")
        rvviSources = sorted(glob.glob(f"{imperas}/ImpPublic/source/host/rvvi/*.sv"))
        if args.fcov:  # --fcov compiles riscv-arch-test's RVVI trace interface instead of ImperasDV's
            rvviSources = [f for f in rvviSources if os.path.basename(f) != "rvviTrace.sv"]
        compileOptions.extend([f"+incdir+{imperas}/ImpPublic/include/host",
                               f"+incdir+{imperas}/ImpPublic/include/host/rvvi",
                               f"+incdir+{imperas}/ImpProprietary/include/host",
                               f"+incdir+{imperas}/ImpProprietary/include/host/idv",
                               *rvviSources,
                               *sorted(glob.glob(f"{imperas}/ImpProprietary/source/host/idv/*.sv"))])
    if args.breker:
        WALLY_UVM_PKG = os.environ.get('WALLY_UVM_PKG')
        if not WALLY_UVM_PKG:
            raise RuntimeError("WALLY_UVM_PKG environment variable is not set for Breker test!")
        compileOptions.extend([f"+incdir+{WALLY}/testbench/trek_files",
                               f"+incdir+{os.path.dirname(WALLY_UVM_PKG)}",
                               "-ntb_opts", "uvm",
                               f"{WALLY_UVM_PKG}",
                               "-top", "trek_uvm"])
    if args.params.strip():
        compileOptions.extend(setupParamOverrides(wkdir, args))
    compileOptions.extend(args.define.split())
    return compileOptions

def fcovCompileOptions(config):
    """Sources, include paths and defines for the riscv-arch-test covergroups, as wally-compile.do adds them.

    riscv_arch_test.sv instantiates the generated covergroups and samples them off the RVVI trace.  It
    needs its own sources, the generated coverpoints, the test environment for derived_config.svh, and
    the work directory of the matching ACT configuration (cvw-<config>) for rvtest_config.svh and
    rvmodel_macros.svh.  Each covergroup is compiled in only when a +define+<GROUP>_COVERAGE names it;
    take every directory of built tests that has a matching covergroup file."""
    fcovsrc = f"{actdir}/framework/src/act/fcov"
    fcovwork = Path(f"{actdir}/work/cvw-{config}")
    if not fcovwork.is_dir():
        sys.exit(f"Error: no ACT work directory {fcovwork}; build its tests before collecting functional coverage")
    elfs = fcovwork / "elfs"
    names = sorted({d.name for d in elfs.rglob("*") if d.is_dir()}) if elfs.is_dir() else []
    groups = [n for n in names if any(Path(f"{actdir}/coverpoints/{k}/{n}_coverage.svh").exists() for k in ("unpriv", "priv"))]
    print(f"Functional coverage: {len(groups)} covergroups")
    return [f"+incdir+{fcovsrc}", f"+incdir+{actdir}/coverpoints",
            f"+incdir+{actdir}/coverpoints/unpriv", f"+incdir+{actdir}/coverpoints/priv",
            f"+incdir+{actdir}/tests/env", f"+incdir+{fcovwork}",
            *(f"+define+{g.upper()}_COVERAGE" for g in groups),
            f"{fcovsrc}/rvviTrace.sv", f"{fcovsrc}/riscv_arch_test.sv"]

def coverageDatabase(args):
    """The coverage database a run writes, named like Questa's .ucdb (see wally-run.do), or None.
    Code coverage goes to ucdb/, functional coverage to fcov_ucdb/; with both, code coverage wins
    and the one database holds both."""
    if args.ccov:
        return f"{simdir}/ucdb/{args.config}_{args.testsuite}.vdb"
    if args.fcov:
        return f"{simdir}/fcov_ucdb/{args.config}_{args.testsuite}.vdb"
    return None

def getSimvOptions(wkdir, args):
    """Build runtime options for the simulation binary."""
    simvOptions = []
    db = coverageDatabase(args)
    if db:
        # Each run writes a database of its own, so that runs can go in parallel and be merged, kept or
        # discarded one at a time.  For code coverage, start it from a copy of the coverage model the
        # compile wrote (sim_out.vdb, without test results) so that it can be reported and merged on its
        # own; the simulation writes only its results there.  Covergroups need no such model.
        shutil.rmtree(db, ignore_errors=True)
        if args.ccov:
            shutil.copytree(f"{wkdir}/sim_out.vdb", db, ignore=shutil.ignore_patterns("testdata"))
        simvOptions.extend(["-cm_dir", db, "-cm_name", args.testsuite])
        if args.ccov:
            simvOptions.extend(["-cm", CCOV_METRICS])
        if args.fcov:
            # VCS W-2024.09 stops with an internal assertion failure ("CovgCountStates result is
            # negative") while sampling some riscv-arch-test covergroups, such as I_beq_cg; riscv-arch-test's
            # own VCS flow (riscv-arch-test-vcs.sh) runs with the same option
            simvOptions.extend(["-vcs_assert", "off"])
    if args.lockstep:
        simvOptions.extend(["-sv_lib", f"{os.environ.get('IMPERAS_HOME', '')}/lib/Linux64/ImperasLib/imperas.com/verification/riscv/1.0/model"])
    if args.breker:
        BREKER_HOME = os.environ.get("BREKER_HOME")
        if not BREKER_HOME:
            raise RuntimeError("BREKER_HOME environment variable is not set for Breker test!")
        simvOptions.extend(["-sv_lib", f"{BREKER_HOME}/linux64/lib/libtrek"])
    return simvOptions

def setupParamOverrides(wkdir, args):
    paramOverrideFile = os.path.join(wkdir, "param_overrides.txt")
    with open(paramOverrideFile, "w") as f:
        for param in args.params.split():
            [param, value] = param.split("=")
            value = value.replace("\\'", "'") if "\\'" in value else f'"{value}"' # transform quotes/bit indicators
            f.write(f"assign {value} {args.tb}/{param}\n")
    return ["-parameters", paramOverrideFile]

def compileDesign(wkdir, args):
    """Compile the design with VCS."""
    os.makedirs(wkdir, exist_ok=True)
    os.makedirs(logdir, exist_ok=True)
    rtlFiles = generateFileList(args.tb, args.params)
    compileOptions = getCompileOptions(wkdir, args)
    includePath = [f"+incdir+{cfgdir}/{args.config}", f"+incdir+{cfgdir}/deriv/{args.config}", f"+incdir+{cfgdir}/shared",
                   f"+incdir+{WALLY}/tests", f"+incdir+{tbdir}", f"+incdir+{srcdir}"]
    vcsStandardFlags = ["+lint=all,noGCWM,noUI,noSVA-UA,noIDTS,noNS,noULCO,noCAWM-L,noWMIA-L,noSV-PIU,noSTASKW_CO,noSTASKW_CO1,noSTASKW_RMCOF",
                        "-suppress", "+warn", "-sverilog", "+vc", "-Mupdate", "-line", "-full64", "-lca", "-ntb_opts", "sensitive_dyn"]
    vcsCMD = ["vcs", *vcsStandardFlags, "-top", args.tb, *compileOptions, f"-Mdir={wkdir}", *includePath, f"{srcdir}/cvw.sv",
              *rtlFiles, "-o", f"{wkdir}/sim_out", "-work", wkdir, f"-Mlib={wkdir}", "-l", f"{logdir}/{os.path.basename(wkdir)}_compile.log"]
    print(f"Compiling VCS: {shlex.join(vcsCMD)}")
    subprocess.run(vcsCMD, check=True)

def run(wkdir, args):
    """Run simulation using the pre-compiled binary."""
    simvOptions = getSimvOptions(wkdir, args)
    simvCMD = [f"{wkdir}/sim_out", f"+TEST={args.testsuite}", *shlex.split(args.args), "-no_save", *simvOptions]
    subprocess.run(simvCMD, check=True)

def main(args):
    wkdir = args.wkdir if args.wkdir else f"{simdir}/wkdir/{args.config}_{args.testsuite}"
    print(f"run_vcs {args.action} Config={args.config} tests={args.testsuite} lockstep={args.lockstep} args='{args.args}' params='{args.params}' define='{args.define}'")
    if args.action == "compile":
        compileDesign(wkdir, args)
    elif args.action == "run":
        run(wkdir, args)

if __name__ == "__main__":
    args = parseArgs()
    sys.exit(main(args))
